rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================
    // AUTHENTICATION
    // =====================================

    function signedIn() {
      return request.auth != null;
    }

    // =====================================
    // PROFILE HELPERS
    // =====================================

    function profile(profileId) {
      return get(
        /databases/$(database)/documents/profiles/$(profileId)
      ).data;
    }

    function isOwner(profileId) {
      return signedIn()
        && profile(profileId).ownerUid == request.auth.uid;
    }

    function isMember(profileId) {
      return signedIn()
        && request.auth.uid in profile(profileId).memberUids;
    }

    // =====================================
    // PROFILE CREATION
    // =====================================

    function validProfileCreation() {
      let data = request.resource.data;

      return signedIn()

        && data.keys().hasAll([
          'ownerUid',
          'kind',
          'name',
          'timezone',
          'roles',
          'memberUids',
          'healthUids',
          'permissions'
        ])

        && data.keys().hasOnly([
          'ownerUid',
          'kind',
          'name',
          'timezone',
          'roles',
          'memberUids',
          'healthUids',
          'permissions',
          'dob',
          'relationship',
          'color',
          'avatarPath',
          'missedAfterMin',
          'conditions',
          'archivedAt',
          'createdAt',
          'updatedAt'
        ])

        && data.ownerUid == request.auth.uid

        && data.kind in ['self', 'dependent', 'adult']

        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200

        && data.timezone is string
        && data.timezone.size() > 0
        && data.timezone.size() <= 100

        && data.roles is map
        && data.roles.keys().size() == 1
        && data.roles.get(request.auth.uid, '') == 'owner'

        && data.memberUids is list
        && data.memberUids == [request.auth.uid]

        && data.healthUids is list
        && data.healthUids == [request.auth.uid]

        && data.permissions is map
        && data.permissions.size() == 0

        && (!('createdAt' in data)
            || data.createdAt == request.time)

        && (!('updatedAt' in data)
            || data.updatedAt == request.time);
    }

    // =====================================
    // PERMISSION CONSISTENCY
    // =====================================

    function validPermissionConsistency(data) {
      return data.roles is map
        && data.memberUids is list
        && data.healthUids is list
        && data.permissions is map

        && data.roles.get(data.ownerUid, '') == 'owner'

        && data.ownerUid in data.memberUids
        && data.ownerUid in data.healthUids

        && data.memberUids.size() <= 20
        && data.healthUids.size() <= 20
        && data.roles.keys().size() <= 20
        && data.permissions.keys().size() <= 20;
    }

    // =====================================
    // PROFILE UPDATE SECURITY
    // =====================================

    function validProfileUpdate() {
      let data = request.resource.data;

      return signedIn()

        // Immutable ownership
        && data.ownerUid == resource.data.ownerUid

        // Only non-security profile fields
        // may be changed by the client
        && data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'timezone',
            'updatedAt',
            'dob',
            'relationship',
            'color',
            'avatarPath',
            'missedAfterMin',
            'conditions',
            'archivedAt'
          ])

        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200

        && data.timezone is string
        && data.timezone.size() > 0
        && data.timezone.size() <= 100

        && validPermissionConsistency(data)

        && data.roles.get(request.auth.uid, '') == 'owner'

        && (!('updatedAt' in data)
            || data.updatedAt == request.time);
    }

    // =====================================
    // MEDICATION PERMISSIONS
    // =====================================

    function canEditMedications(profileId) {
      return isOwner(profileId)
        || (
          isMember(profileId)

          && profile(profileId).roles
            .get(request.auth.uid, '') == 'caregiver'

          && profile(profileId).permissions
            .get(request.auth.uid, {})
            .get('editMedications', false) == true
        );
    }

    // =====================================
    // DOSE PERMISSIONS
    // =====================================

    function canLogDoses(profileId) {
      return isOwner(profileId)
        || (
          isMember(profileId)

          && profile(profileId).roles
            .get(request.auth.uid, '') == 'caregiver'

          && profile(profileId).permissions
            .get(request.auth.uid, {})
            .get('logDoses', false) == true
        );
    }

    // =====================================
    // MEDICATION VALIDATION (M5)
    // =====================================

    // M5: Validate schedule shape (used by validMedicationCreate + Update)
    // Per plan: "type in the allowed list, times non-empty unless PRN,
    //            endDate >= startDate, numbers in range"
    function validSchedule(schedule) {
      return schedule is map
        && schedule.keys().hasAll(['type', 'startDate', 'version'])
        && schedule.type in ['daily', 'weekdays', 'cyclical', 'prn', 'taper']
        && schedule.version is int

        // PRN: times can be empty
        // All other types: times must be non-empty list
        && (schedule.type == 'prn'
            || (schedule.times is list && schedule.times.size() > 0))

        // Weekdays type: weekdays list required, values 1-7
        && (schedule.type != 'weekdays'
            || (schedule.weekdays is list
                && schedule.weekdays.size() > 0
                && schedule.weekdays.size() <= 7))

        // Cyclical type: cycleOn + cycleOff + cycleStart required
        && (schedule.type != 'cyclical'
            || (schedule.cycleOn is int && schedule.cycleOn > 0
                && schedule.cycleOff is int && schedule.cycleOff > 0
                && 'cycleStart' in schedule))

        // Taper type: taperSteps required (non-empty list)
        && (schedule.type != 'taper'
            || (schedule.taperSteps is list
                && schedule.taperSteps.size() > 0))

        // endDate >= startDate (if endDate present)
        && (!('endDate' in schedule)
            || schedule.endDate >= schedule.startDate);
    }

    // M5: Validate medication document on create.
    // Per plan: "Rules check canWrite(pid) and validate the shape"
    // Per plan: "Rules also block client writes to quantityOnHand,
    //            daysOfSupply and flags, which only functions maintain."
    function validMedicationCreate() {
      let data = request.resource.data;

      return data.keys().hasAll([
              'name',
              'profileId',
              'status',
              'source',
              'schedule',
              'lowStockDays',
              'createdAt',
              'createdBy',
              'updatedAt',
              'updatedBy'
            ])

        // Server-maintained fields must NOT be present on create
        && !('quantityOnHand' in data)
        && !('daysOfSupply' in data)
        && !('flags' in data)

        // Status must be 'active' on create (use archive flow to change)
        && data.status == 'active'

        // Type validations
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.profileId is string
        && data.source is string
        && data.source in ['search', 'scan', 'manual']
        && data.lowStockDays is int
        && data.lowStockDays >= 1
        && data.lowStockDays <= 90

        // Schedule shape validation
        && validSchedule(data.schedule);
    }

    // M5: Validate medication document on update.
    // Per plan: blocks client writes to:
    //   - Server-maintained fields (quantityOnHand, daysOfSupply, flags)
    //   - Lifecycle fields (status, archivedReason - use archiveMedication method)
    //   - Immutable fields (profileId, createdBy, createdAt, source, rxcui)
    //   - If schedule changes, new schedule must be valid
    function validMedicationUpdate() {
      let data = request.resource.data;
      let diff = data.diff(resource.data).affectedKeys();

      return diff.hasAny(['updatedAt'])

        // Block immutable fields from being changed
        && !diff.hasAny(['profileId', 'createdBy', 'createdAt', 'source', 'rxcui'])

        // Block server-maintained fields (only functions update these)
        && !diff.hasAny(['quantityOnHand', 'daysOfSupply', 'flags'])

        // Block lifecycle fields (use archiveMedication repository method instead)
        && !diff.hasAny(['status', 'archivedReason'])

        // If schedule is being updated, validate new shape
        && (!diff.hasAny(['schedule']) || validSchedule(data.schedule));
    }

    // =====================================
    // DOSE VALIDATION (M7)
    // =====================================

    // M7: Validate dose document on update.
    // Per plan: "Rules allow only canWrite(pid), only these fields,
    //            and only valid transitions."
    function validDoseUpdate() {
      let data = request.resource.data;
      let diff = data.diff(resource.data).affectedKeys();

      // Only these fields can be changed by client
      return diff.hasOnly([
              'status',
              'loggedAt',
              'loggedBy',
              'reasonCode',
              'reasonText',
              'snoozedUntil',
              'missDeadline'
            ])

        // Validate status transition (if status is changing)
        && validDoseTransition();
    }

    // M7: Validate status transitions.
    // Per plan: "pending/missed → taken/skipped,
    //            plus taken/skipped → pending within 24 h for undo."
    // NOTE: CEL does NOT support `if` statements — use logical operators instead.
        function validDoseTransition() {
      let before = resource.data;
      let after = request.resource.data;
      let oldStatus = before.status;
      let newStatus = after.status;

      return !('status' in after.diff(before).affectedKeys())
        || (
          (oldStatus == 'pending' && newStatus == 'taken')
          || (oldStatus == 'pending' && newStatus == 'skipped')
          || (oldStatus == 'pending' && newStatus == 'missed')
          || (oldStatus == 'missed' && newStatus == 'taken')
          || (oldStatus == 'missed' && newStatus == 'skipped')
          || (oldStatus == 'taken' && newStatus == 'pending')
          || (oldStatus == 'skipped' && newStatus == 'pending')
        );
    }

    // =====================================
    // M3: GENERAL ACCESS HELPERS
    // =====================================

    // M3: Any member can read (owner, caregiver, viewer)
    function canRead(profileId) {
      return isMember(profileId);
    }

    // M3: Owner or caregiver can write (general write, not just meds)
    function canWrite(profileId) {
      return isOwner(profileId)
        || (
          isMember(profileId)

          && profile(profileId).roles
            .get(request.auth.uid, '') == 'caregiver'
        );
    }

    // =====================================
    // HEALTH ACCESS
    // =====================================

    function canViewHealth(profileId) {
      return isOwner(profileId)
        || (
          isMember(profileId)

          && request.auth.uid
            in profile(profileId).healthUids
        );
    }

    // =====================================
    // VITALS & SYMPTOMS (M15 step 2)
    //
    // Limits below must match lib/core/vitals/vital_validator.dart and
    // symptom_validator.dart. Reads stay in the generic health-records block
    // (canViewHealth); this section only adds WRITE rules.
    // =====================================

    // Owner, or a caregiver who may also see health data.
    // Viewers (even with health access) are read-only.
    function canWriteHealth(profileId) {
      return canViewHealth(profileId)
        && (
          isOwner(profileId)
          || profile(profileId).roles.get(request.auth.uid, '') == 'caregiver'
        );
    }

    // Edit / delete an entry: whoever created it, or the profile owner.
    function canEditOwnHealthEntry(profileId) {
      return canWriteHealth(profileId)
        && (
          resource.data.createdBy == request.auth.uid
          || isOwner(profileId)
        );
    }

    function vitalUnitOk(d) {
      return (d.type == 'bloodPressure' && d.unit == 'mmHg')
        || (d.type == 'glucose' && d.unit == 'mg/dL')
        || (d.type == 'weight' && d.unit == 'kg')
        || (d.type == 'heartRate' && d.unit == 'bpm');
    }

    function vitalValuesOk(d) {
      return d.value is number
        && (
          (d.type == 'bloodPressure'
            && d.value >= 40 && d.value <= 300
            && ('value2' in d) && d.value2 is number
            && d.value2 >= 20 && d.value2 <= 200
            && d.value2 < d.value
            && (!('pulse' in d)
                || (d.pulse is number && d.pulse >= 20 && d.pulse <= 300)))
          || (d.type == 'glucose'
            && d.value >= 10 && d.value <= 1000
            && !('value2' in d) && !('pulse' in d))
          || (d.type == 'weight'
            && d.value >= 1 && d.value <= 700
            && !('value2' in d) && !('pulse' in d))
          || (d.type == 'heartRate'
            && d.value >= 20 && d.value <= 300
            && !('value2' in d) && !('pulse' in d))
        );
    }

    function validVitalCreate(vitalId) {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'type', 'value', 'value2', 'pulse', 'unit', 'measuredAt',
          'source', 'externalId', 'note', 'createdBy', 'createdAt'
        ])
        && d.keys().hasAll([
          'type', 'value', 'unit', 'measuredAt', 'source',
          'createdBy', 'createdAt'
        ])
        && d.type in ['bloodPressure', 'glucose', 'weight', 'heartRate']
        && d.unit is string
        && vitalUnitOk(d)
        && vitalValuesOk(d)
        && d.measuredAt is timestamp
        && d.measuredAt <= request.time + duration.value(10, 'm')
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && d.source in ['manual', 'healthkit', 'health_connect']
        && (
          d.source == 'manual'
            // manual: random id that cannot look like a synced one
            ? (!('externalId' in d)
               && !vitalId.matches('healthkit_.*')
               && !vitalId.matches('health_connect_.*'))
            // synced: id is {source}_{externalId} so re-syncing never
            // creates a duplicate
            : (d.externalId is string
               && d.externalId.size() > 0
               && d.externalId.size() <= 500
               && vitalId.matches(d.source + '_.+'))
        )
        && (!('note' in d) || (d.note is string && d.note.size() <= 500));
    }

    // A recorded reading is never edited (no quiet changes to history);
    // only its note may change.
    function validVitalNoteUpdate() {
      let d = request.resource.data;

      return d.diff(resource.data).affectedKeys().hasOnly(['note'])
        && (!('note' in d) || (d.note is string && d.note.size() <= 500));
    }

    function validSymptomCreate(profileId) {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'symptom', 'severity', 'medicationId', 'occurredAt',
          'notes', 'createdBy', 'createdAt'
        ])
        && d.keys().hasAll([
          'symptom', 'severity', 'occurredAt', 'createdBy', 'createdAt'
        ])
        && d.symptom is string
        && d.symptom.size() >= 1
        && d.symptom.size() <= 100
        && d.severity is int
        && d.severity >= 1 && d.severity <= 5
        && d.occurredAt is timestamp
        && d.occurredAt <= request.time + duration.value(10, 'm')
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500))
        && (
          !('medicationId' in d)
          || (
            d.medicationId is string
            && d.medicationId.size() > 0
            && exists(
              /databases/$(database)/documents/profiles/$(profileId)/medications/$(d.medicationId)
            )
          )
        );
    }

    function validSymptomNotesUpdate() {
      let d = request.resource.data;

      return d.diff(resource.data).affectedKeys().hasOnly(['notes'])
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500));
    }

    // vitalsDaily/{type}_{yyyy-MM-dd}: summary written by the app (Spark has
    // no Cloud Function). avg is rounded to 1 decimal, hence the 0.05 slack.
    function vitalDailyRangeOk(d) {
      return (d.type == 'bloodPressure'
          && d.min >= 40 && d.max <= 300
          && ('avg2' in d) && ('min2' in d) && ('max2' in d)
          && d.avg2 is number && d.min2 is number && d.max2 is number
          && d.min2 >= 20 && d.max2 <= 200 && d.min2 <= d.max2
          && d.avg2 >= d.min2 - 0.05 && d.avg2 <= d.max2 + 0.05)
        || (d.type == 'glucose' && d.min >= 10 && d.max <= 1000
          && !('avg2' in d) && !('min2' in d) && !('max2' in d))
        || (d.type == 'weight' && d.min >= 1 && d.max <= 700
          && !('avg2' in d) && !('min2' in d) && !('max2' in d))
        || (d.type == 'heartRate' && d.min >= 20 && d.max <= 300
          && !('avg2' in d) && !('min2' in d) && !('max2' in d));
    }

    function validVitalDaily(dailyId) {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'type', 'day', 'count', 'avg', 'min', 'max',
          'avg2', 'min2', 'max2', 'updatedAt'
        ])
        && d.keys().hasAll([
          'type', 'day', 'count', 'avg', 'min', 'max', 'updatedAt'
        ])
        && d.type in ['bloodPressure', 'glucose', 'weight', 'heartRate']
        && d.day is string
        && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && dailyId == d.type + '_' + d.day
        && d.count is int && d.count >= 1 && d.count <= 5000
        && d.avg is number && d.min is number && d.max is number
        && d.min <= d.max
        && d.avg >= d.min - 0.05 && d.avg <= d.max + 0.05
        && vitalDailyRangeOk(d)
        && d.updatedAt == request.time;
    }

    // =====================================
    // PRESCRIBERS, APPOINTMENTS, DOCTOR NOTES (M16 step 2)
    //
    // Limits must match lib/core/doctors/*_validator.dart. Reads stay in the
    // generic health-records block (canViewHealth); this section only adds
    // WRITE rules. Owner or caregiver (canWriteHealth) may write.
    // =====================================

    // M16 step 7: prescribers, appointments and doctor notes are Solo Pro.
    // The entitlement is the PROFILE OWNER's (a family plan covers every
    // profile its owner has), read from customers/{ownerUid}, which only the
    // server can write (M12). Same rule as the app's hasPremiumAccess:
    // active / trial / grace period, or canceled but still inside the paid
    // period. Only create and update are gated: reads and deletes stay open,
    // so after a downgrade the data is read-only but never lost or stuck.
    function ownerIsPro(profileId) {
      let path = /databases/$(database)/documents/customers/$(profile(profileId).ownerUid);

      return exists(path)
        && (
          get(path).data.get('status', '') in ['active', 'trial', 'grace_period']
          || (
            get(path).data.get('status', '') == 'canceled'
            && get(path).data.get('expiresAt', null) is timestamp
            && get(path).data.expiresAt > request.time
          )
        );
    }

    function optStrMax(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // Offsets are stored largest first, no duplicates (the app normalises),
    // so "strictly descending" also rules out duplicates. Rules have no loops,
    // hence the explicit positions (max 5 offsets).
    function offsetAt(l, i) {
      return l.size() <= i
        || (l[i] is int && l[i] >= 1 && l[i] <= 43200);
    }

    function offsetOrder(l, i) {
      return l.size() <= i + 1 || l[i] > l[i + 1];
    }

    function validOffsets(l) {
      return l is list
        && l.size() <= 5
        && offsetAt(l, 0) && offsetAt(l, 1) && offsetAt(l, 2)
        && offsetAt(l, 3) && offsetAt(l, 4)
        && offsetOrder(l, 0) && offsetOrder(l, 1)
        && offsetOrder(l, 2) && offsetOrder(l, 3);
    }

    function validPrescriberShape() {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'name', 'specialty', 'phone', 'clinic', 'address',
          'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && d.name is string
        && d.name.size() >= 1 && d.name.size() <= 80
        && optStrMax(d, 'specialty', 60)
        && optStrMax(d, 'clinic', 80)
        && optStrMax(d, 'address', 200)
        && (
          !('phone' in d)
          || (d.phone is string
              && d.phone.matches('\\+?[0-9 ()\\-]+')
              && d.phone.matches('[^0-9]*([0-9][^0-9]*){7,15}'))
        )
        && d.updatedAt == request.time;
    }

    function validPrescriberCreate() {
      return validPrescriberShape()
        && request.resource.data.createdAt == request.time;
    }

    function validPrescriberUpdate() {
      return validPrescriberShape()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validAppointmentShape(profileId) {
      let d = request.resource.data;

      return d.keys().hasOnly([
          'startsAt', 'prescriberId', 'type', 'location', 'notes',
          'reminderOffsets', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'startsAt', 'type', 'reminderOffsets', 'createdAt', 'updatedAt'
        ])
        && d.startsAt is timestamp
        && d.type in ['follow_up', 'checkup', 'lab_review', 'other']
        && optStrMax(d, 'location', 200)
        && optStrMax(d, 'notes', 500)
        && validOffsets(d.reminderOffsets)
        && (
          !('prescriberId' in d)
          || (
            d.prescriberId is string
            && d.prescriberId.size() > 0
            && exists(
              /databases/$(database)/documents/profiles/$(profileId)/prescribers/$(d.prescriberId)
            )
          )
        )
        && d.updatedAt == request.time;
    }

    function validAppointmentCreate(profileId) {
      return validAppointmentShape(profileId)
        && request.resource.data.createdAt == request.time;
    }

    function validAppointmentUpdate(profileId) {
      return validAppointmentShape(profileId)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validDoctorNoteCreate() {
      let d = request.resource.data;

      return d.keys().hasOnly(['body', 'createdAt', 'doneAt', 'appointmentId'])
        && d.keys().hasAll(['body', 'createdAt', 'doneAt'])
        && d.body is string
        && d.body.size() >= 1 && d.body.size() <= 500
        && d.createdAt == request.time
        && d.doneAt == null
        && (
          !('appointmentId' in d)
          || (d.appointmentId is string
              && d.appointmentId.size() > 0
              && d.appointmentId.size() <= 100)
        );
    }

    // Only the text and the done flag may change; doneAt is null (open again)
    // or the time of the change.
    function validDoctorNoteUpdate() {
      let d = request.resource.data;

      return d.diff(resource.data).affectedKeys().hasOnly(['body', 'doneAt'])
        && d.body is string
        && d.body.size() >= 1 && d.body.size() <= 500
        && (d.doneAt == null || d.doneAt == request.time);
    }

    // =====================================
    // USER UPDATE SECURITY (M2)
    // =====================================

    // M2: User can create their own document but NOT set
    // sensitive fields (plan, role, deletionRequestedAt).
    // hasOnly() already blocks these — they're not in the list.
    function validUserCreate() {
      let data = request.resource.data;

      return data.keys().hasOnly([
        'email',
        'displayName',
        'timezone',
        'settings',
        'legalVersions',
        'aiConsentAt',
        'legal',
        'selectedMemberId',
        'selectedDisplayName',
        'selectedProfileImageUrl',
        'createdAt',
        'updatedAt'
      ]);
    }

    // M2: User can update their own document but ONLY
    // non-sensitive fields. hasOnly() already blocks
    // plan, role, deletionRequestedAt — they're not in the list.
    function validUserUpdate() {
      let data = request.resource.data;

      return data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'email',
          'displayName',
          'timezone',
          'settings',
          'legalVersions',
          'aiConsentAt',
          'legal',
          'selectedMemberId',
          'selectedDisplayName',
          'selectedProfileImageUrl',
          'updatedAt'
        ]);
    }

    // M14 step 4: account deletion request / cancel.
    // The user may ONLY set deletionRequestedAt to the server time
    // (request) or remove it (cancel), together with updatedAt.
    // Nothing else may change in the same write.
    function validDeletionChange() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();

      return changed.hasOnly(['deletionRequestedAt', 'updatedAt'])
        && changed.hasAny(['deletionRequestedAt'])
        && (
          !('deletionRequestedAt' in data)
          || data.deletionRequestedAt == request.time
        );
    }

    // M14 step 5: account purge. Data may be deleted by its owner only
    // after the user asked for deletion AND the 7-day grace period is over
    // (users/{uid}.deletionRequestedAt + 7 days <= request.time).
    // Keep the 7 in sync with AccountDeletionPolicy.graceDays in the app.
    function accountDeletionDue() {
      let u = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;

      return u.get('deletionRequestedAt', null) != null
        && request.time >= u.deletionRequestedAt + duration.value(7, 'd');
    }

    function canPurgeProfile(profileId) {
      return isOwner(profileId) && accountDeletionDue();
    }

    // M14 step 6: a member (not the owner) may remove THEIR OWN access from a
    // profile — needed when they delete their account. Exactly their uid may
    // disappear from memberUids / healthUids / roles / permissions; nothing
    // else may change and nobody else's access is touched.
    function validSelfLeave() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();

      return signedIn()
        && uid in before.memberUids
        && before.ownerUid != uid
        && changed.hasOnly([
          'memberUids', 'healthUids', 'roles', 'permissions', 'updatedAt'
        ])
        && changed.hasAny(['memberUids'])

        && !(uid in after.memberUids)
        && after.memberUids.hasOnly(before.memberUids)
        && after.memberUids.size() == before.memberUids.size() - 1

        && !(uid in after.healthUids)
        && after.healthUids.hasOnly(before.healthUids)
        && after.healthUids.size() >= before.healthUids.size() - 1

        && !(uid in after.roles)
        && after.roles.diff(before.roles).affectedKeys().hasOnly([uid])

        && !(uid in after.permissions)
        && after.permissions.diff(before.permissions).affectedKeys().hasOnly([uid])

        && (!('updatedAt' in after) || after.updatedAt == request.time);
    }

    // =====================================
    // USERS
    // =====================================

    match /users/{uid} {

      // M2: User can read their own document
      allow read: if signedIn()
        && request.auth.uid == uid;

      // M2: User can create their own document (with validation)
      allow create: if signedIn()
        && request.auth.uid == uid
        && validUserCreate();

      // M2: User can update their own document (with validation)
      // Sensitive fields (plan, role, deletionRequestedAt) are blocked
      allow update: if signedIn()
        && request.auth.uid == uid
        && (validUserUpdate() || validDeletionChange());

      // M14 step 5: only after the grace period (accountDeletionDue)
      allow delete: if signedIn()
        && request.auth.uid == uid
        && accountDeletionDue();

      match /devices/{deviceId} {

        allow read, write: if signedIn()
          && request.auth.uid == uid;
      }
    }

    // =====================================
    // CUSTOMERS (M12 — RevenueCat subscription state)
    // =====================================

    match /customers/{uid} {

      // M12: Users can read only their own subscription record
      allow read: if signedIn()
        && request.auth.uid == uid;

      // M12: Written only by the server (RevenueCat webhook / Admin SDK).
      // Clients must never grant themselves a plan.
      allow write: if false;
    }

    // =====================================
    // CONFIG (M13 step 4 — FAQ and other remote content)
    // =====================================

    match /config/{docId} {

      // Signed-in users can read app content such as config/faq.
      allow read: if signedIn();

      // Edited only from the Firebase console / Admin SDK.
      allow write: if false;
    }

    // =====================================
    // SUPPORT TICKETS (M13 step 5)
    // =====================================

    // A ticket may only be created by its owner, with exactly the expected
    // fields and sane sizes. createdAt must be the server time.
    function validTicketCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'uid', 'subject', 'body', 'appVersion', 'device',
          'locale', 'status', 'createdAt'
        ])
        && d.keys().hasAll([
          'uid', 'subject', 'body', 'appVersion', 'device',
          'status', 'createdAt'
        ])
        && d.uid == request.auth.uid
        && d.subject is string && d.subject.size() >= 1 && d.subject.size() <= 120
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 2000
        && d.appVersion is string && d.appVersion.size() <= 40
        && d.device is string && d.device.size() <= 120
        && (!('locale' in d) || (d.locale is string && d.locale.size() <= 10))
        && d.status == 'open'
        && d.createdAt == request.time;
    }

    match /supportTickets/{ticketId} {

      allow create: if signedIn() && validTicketCreate();

      // Users can read only their own tickets (support staff use the console).
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      // Tickets are immutable from the client.
      allow update, delete: if false;
    }

    // =====================================
    // PATIENT PROFILES
    // =====================================

    match /profiles/{profileId} {

      allow create: if validProfileCreation();

      // M3: Split read into get + list
      // get = single doc read (uses get() in isMember — OK)
      // list = query (can't use get() — just check auth, query constrains results)
      allow get: if isMember(profileId);
      allow list: if signedIn();

      allow update: if (isOwner(profileId)
        && validProfileUpdate())
        || validSelfLeave();

      // M14 step 5: owner purge after the grace period
      allow delete: if canPurgeProfile(profileId);

      // =====================================
      // MEDICATIONS (M5)
      // =====================================

      match /medications/{medId} {

        // M5: Split read into get + list (same pattern as profiles)
        // get = single doc read (uses get() in isMember — OK)
        // list = query / stream (can't use get() — just check auth)
        allow get: if isMember(profileId);
        allow list: if signedIn();

        // M5: Create — owner/caregiver with full validation
        // (validMedicationCreate blocks server-maintained fields)
        allow create: if canEditMedications(profileId)
          && validMedicationCreate();

        // M5: Update — owner/caregiver with shape validation
        // (validMedicationUpdate blocks immutable + server-maintained + lifecycle fields)
        allow update: if canEditMedications(profileId)
          && validMedicationUpdate();

        // M5: "Archive, never delete." — deletion not allowed
        // (use archiveMedication method to discontinue)
        // Exception (M14 step 5): account purge after the grace period.
        allow delete: if canPurgeProfile(profileId);

        match /inventoryEvents/{eventId} {

          allow read: if isMember(profileId);

          allow create:
            if canEditMedications(profileId);

          allow update: if false;

          // M14 step 5: account purge only
          allow delete: if canPurgeProfile(profileId);
        }
      }

      // M9: Pharmacies (name, phone, address, linked to medications)
      match /pharmacies/{pharmacyId} {
        allow read: if isMember(profileId);
        allow create: if canEditMedications(profileId);
        allow update: if canEditMedications(profileId);
        allow delete: if canPurgeProfile(profileId);
      }

      // =====================================
      // DOSES (M7)
      // =====================================

      match /doses/{doseId} {

        // M7: Split read into get + list (same pattern as profiles/medications)
        allow get: if isMember(profileId);
        allow list: if signedIn();

        // M7: Create — dose generation (canEditMedications) OR PRN logging (canLogDoses)
        allow create: if canEditMedications(profileId)
          || canLogDoses(profileId);

        // M7: Update — logging (canLogDoses) OR regeneration (canEditMedications)
        // + validDoseUpdate() enforces field restrictions + valid transitions
        allow update: if (canEditMedications(profileId)
          || canLogDoses(profileId))
          && validDoseUpdate();

        // M7: Delete — only canEditMedications, and only for pending doses
        // (logged history stays — never delete taken/skipped/missed)
        allow delete: if (canEditMedications(profileId)
          && resource.data.status == 'pending')
          || canPurgeProfile(profileId);
      }

      // =====================================
      // DAILY SUMMARIES
      // =====================================

      match /dailySummaries/{date} {

        allow read: if isMember(profileId);

        allow write: if false;

        // M14 step 5: account purge only
        allow delete: if canPurgeProfile(profileId);
      }

      // =====================================
      // ALLERGIES (M3)
      // =====================================

      match /allergies/{allergyId} {

        // M3: Any member can read allergies
        allow read: if canRead(profileId);

        // M3: Owner or caregiver can create/update allergies
        allow create, update: if canWrite(profileId);

        // M3: Only owner can delete allergies
        allow delete: if isOwner(profileId);
      }

      // =====================================
      // VITALS, SYMPTOMS, DAILY SUMMARIES (M15 step 2)
      // Reads: generic health block below (canViewHealth).
      // Deletes by account purge: generic health block below.
      // =====================================

      match /vitals/{vitalId} {
        allow create: if canWriteHealth(profileId)
          && validVitalCreate(vitalId);

        allow update: if canEditOwnHealthEntry(profileId)
          && validVitalNoteUpdate();

        allow delete: if canEditOwnHealthEntry(profileId);
      }

      match /symptoms/{symptomId} {
        allow create: if canWriteHealth(profileId)
          && validSymptomCreate(profileId);

        allow update: if canEditOwnHealthEntry(profileId)
          && validSymptomNotesUpdate();

        allow delete: if canEditOwnHealthEntry(profileId);
      }

      match /vitalsDaily/{dailyId} {
        allow create, update: if canWriteHealth(profileId)
          && validVitalDaily(dailyId);

        allow delete: if canWriteHealth(profileId);
      }

      // =====================================
      // PRESCRIBERS, APPOINTMENTS, DOCTOR NOTES (M16 step 2)
      // Reads and purge deletes: generic health block below.
      // =====================================

      match /prescribers/{prescriberId} {
        allow create: if canWriteHealth(profileId)
          && ownerIsPro(profileId)
          && validPrescriberCreate();

        allow update: if canWriteHealth(profileId)
          && ownerIsPro(profileId)
          && validPrescriberUpdate();

        allow delete: if canWriteHealth(profileId);
      }

      match /appointments/{appointmentId} {
        allow create: if canWriteHealth(profileId)
          && ownerIsPro(profileId)
          && validAppointmentCreate(profileId);

        allow update: if canWriteHealth(profileId)
          && ownerIsPro(profileId)
          && validAppointmentUpdate(profileId);

        allow delete: if canWriteHealth(profileId);
      }

      match /doctorNotes/{noteId} {
        allow create: if canWriteHealth(profileId)
          && ownerIsPro(profileId)
          && validDoctorNoteCreate();

        allow update: if canWriteHealth(profileId)
          && ownerIsPro(profileId)
          && validDoctorNoteUpdate();

        allow delete: if canWriteHealth(profileId);
      }

      // =====================================
      // SENSITIVE HEALTH RECORDS
      // =====================================

      match /{collection}/{docId} {

        allow read: if canViewHealth(profileId)
          && collection in [
            'allergies',
            'safetyWarnings',
            'vitals',
            'vitalsDaily',
            'symptoms',
            'prescribers',
            'appointments',
            'doctorNotes'
          ];

        allow write: if false;

        // M14 step 5: account purge only
        allow delete: if canPurgeProfile(profileId)
          && collection in [
            'allergies',
            'safetyWarnings',
            'vitals',
            'vitalsDaily',
            'symptoms',
            'prescribers',
            'appointments',
            'doctorNotes'
          ];
      }
    }

    // =====================================
    // DEFAULT DENY
    // =====================================

    match /{document=**} {

      allow read, write: if false;
    }
  }
}