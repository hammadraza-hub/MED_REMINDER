<?xml version="1.0" encoding="utf-8"?>
<!-- M21 step 4: nothing from this app is copied to Google Drive or to a new
     phone by the system. Health data comes back from the account (Firestore)
     after signing in; it must not travel in an automatic backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
